{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Catalyst Link",
  "version": "1.0.0",
  "identifier": "com.frccatalyst.link",
  "build": {
    "frontendDist": "../src",
    "beforeBuildCommand": "node scripts/check-identity.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Catalyst Link",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0d0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
